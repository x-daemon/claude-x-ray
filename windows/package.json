{
  "name": "s2a-claude-x-ray",
  "productName": "S2A Claude X-Ray",
  "version": "0.8.1",
  "description": "Usage, live trace and reports for Claude Code on Windows",
  "author": "S2A",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis zip --x64 --arm64 --publish never",
    "harness": "tsx scripts/dev-server.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^22.20.5",
    "adm-zip": "^0.6.1",
    "echarts": "^6.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-preact": "^1.73.0",
    "preact": "^11.2.0",
    "qrcode-generator": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.s2a.claude-xray",
    "productName": "S2A Claude X-Ray",
    "executableName": "S2A Claude X-Ray",
    "copyright": "S2A",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "S2A-Claude-X-Ray-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "S2A Claude X-Ray",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "S2A-Claude-X-Ray-Setup-${version}-${arch}.${ext}",
      "language": "1049",
      "runAfterFinish": true
    }
  }
}
